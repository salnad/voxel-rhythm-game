{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://voxel-rhythm.local/schema/chart.schema.json",
  "title": "Voxel Rhythm chart (version 1)",
  "description": "A map = an audio file + this chart. Times are in beats; seconds = offsetMs/1000 + beat * 60 / bpm (piecewise with bpmChanges). See docs/map-format.md.",
  "type": "object",
  "required": ["format", "version", "meta", "audio", "timing", "lanes", "notes"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "voxel-rhythm-chart" },
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "artist": { "type": "string" },
        "charter": { "type": "string" },
        "difficulty": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "audio": {
      "type": "object",
      "description": "Exactly one of file or procedural.",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Audio path relative to the chart file."
        },
        "procedural": {
          "type": "string",
          "minLength": 1,
          "description": "Built-in procedural song, e.g. hyperpop-demo."
        },
        "lengthBeats": { "type": "number", "exclusiveMinimum": 0 }
      },
      "oneOf": [{ "required": ["file"] }, { "required": ["procedural"] }]
    },
    "timing": {
      "type": "object",
      "required": ["bpm", "offsetMs"],
      "properties": {
        "bpm": { "type": "number", "minimum": 20, "maximum": 400 },
        "offsetMs": {
          "type": "number",
          "description": "Milliseconds into the audio where beat 0 lands."
        },
        "beatsPerBar": { "type": "integer", "minimum": 1, "maximum": 16 },
        "bpmChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["beat", "bpm"],
            "properties": {
              "beat": { "type": "number", "exclusiveMinimum": 0 },
              "bpm": { "type": "number", "minimum": 20, "maximum": 400 }
            }
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,23}$" },
      "description": "Lane names, left to right. Each lane is a song element, e.g. kick, perc, bass, synth."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["beat", "lane"],
        "properties": {
          "beat": {
            "type": "number",
            "minimum": 0,
            "description": "Beat position from beat 0 (0.5 = eighth note, 0.25 = sixteenth)."
          },
          "lane": { "type": "string", "description": "Must be one of lanes." },
          "length": {
            "type": "number",
            "minimum": 0,
            "description": "Hold length in beats; omit for a tap."
          }
        }
      }
    }
  }
}
